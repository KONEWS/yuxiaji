{
  "name": "yuexiaji-backup-archive-test",
  "main": "backup-archive-worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "DEFAULT_USER_ID": "backup-archive-owner", "YUEXIAJI_CREDENTIALS_ENCRYPTION_KEY": "fixture-only-not-a-production-credential" },
  "d1_databases": [{ "binding": "DB", "database_name": "backup-archive-test", "database_id": "00000000-0000-0000-0000-000000000072" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "backup-archive-test-assets" }]
}
