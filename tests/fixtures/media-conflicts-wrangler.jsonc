{
  "name": "yuexiaji-media-conflicts-test",
  "main": "media-conflicts-worker.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DEFAULT_USER_ID": "media-conflicts-owner",
    "YUEXIAJI_NOVA_TOKEN": "media-conflicts-nova"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "media-conflicts-test", "database_id": "00000000-0000-0000-0000-000000000051" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "media-conflicts-test-assets" }]
}
