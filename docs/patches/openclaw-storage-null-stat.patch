+    def test_successful_null_stat_is_missing(self):
+        adapter = storage_adapter.RcloneStorageAdapter("mega", binary="rclone-test")
+        missing = subprocess.CompletedProcess([], 0, "null\n", "")
+        with mock.patch.object(adapter, "_run", return_value=missing):
+            result = adapter.stat("originals/pixiv/1/a.png")
+        self.assertEqual(result["state"], "missing")
+
+    def test_failed_null_stat_is_indeterminate(self):
+        adapter = storage_adapter.RcloneStorageAdapter("mega", binary="rclone-test")
+        failed = subprocess.CompletedProcess([], 1, "null\n", "temporary failure")
+        with mock.patch.object(adapter, "_run", return_value=failed):
+            result = adapter.stat("originals/pixiv/1/a.png")
+        self.assertEqual(result["state"], "indeterminate")
+
+    def test_existing_stat_is_present_and_directory_is_rejected(self):
+        adapter = storage_adapter.RcloneStorageAdapter("mega", binary="rclone-test")
+        existing = subprocess.CompletedProcess([], 0, '{"IsDir":false,"Size":17,"ID":"object-1"}', "")
+        with mock.patch.object(adapter, "_run", return_value=existing):
+            result = adapter.stat("originals/pixiv/1/a.png")
+        self.assertEqual(result["state"], "present")
+        self.assertEqual(result["size"], 17)
+        directory = subprocess.CompletedProcess([], 0, '{"IsDir":true,"Size":-1}', "")
+        with mock.patch.object(adapter, "_run", return_value=directory):
+            with self.assertRaises(storage_adapter.StorageAdapterError):
+                adapter.stat("originals/pixiv/1/a.png")
