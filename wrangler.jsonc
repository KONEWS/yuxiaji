{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tsuki-anime-rebuild",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuexiaji-db",
      "database_id": "a93978dc-587c-4936-8209-ae073208d163",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "yuexiaji-assets"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
